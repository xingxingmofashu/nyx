{
  "name": "@nyx/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && bun run scripts/build.ts",
    "dev": "bun run src/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@nyx/agent": "workspace:*",
    "@nyx/llm": "workspace:*",
    "ai": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  }
}
