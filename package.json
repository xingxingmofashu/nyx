{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nyx",
  "version": "0.1.0",
  "description": "A from-scratch desktop agent with hybrid cloud + local ONNX inference",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@types/bun": "1.4.0",
      "@types/node": "26.4.0",
      "@types/turndown": "5.0.5",
      "@types/write-file-atomic": "4.0.3",
      "typescript": "7.0.2",
      "@huggingface/transformers": "3.8.1",
      "onnxruntime-node": "1.29.0",
      "hono": "4.13.5",
      "@hono/node-server": "2.1.1",
      "sharp": "0.34.5",
      "yargs": "18.1.0",
      "zod": "3.25.76",
      "ai": "7.0.99",
      "@ai-sdk/tui": "1.0.100",
      "@ai-sdk/react": "4.0.102",
      "@ai-sdk/openai-compatible": "3.0.48",
      "@ai-sdk/anthropic": "4.0.53",
      "@ai-sdk/provider": "4.0.14",
      "streamdown": "2.6.0",
      "@streamdown/code": "1.1.1",
      "@streamdown/cjk": "1.0.3",
      "@hono/zod-validator": "0.9.1",
      "@lancedb/lancedb": "0.38.0",
      "apache-arrow": "18.1.0",
      "eventsource-parser": "4.1.0",
      "htmlparser2": "8.0.2",
      "is-path-inside": "4.0.0",
      "mrmime": "2.0.1",
      "nanoid": "6.0.1",
      "pathe": "2.0.3",
      "turndown": "7.2.0",
      "write-file-atomic": "8.0.0"
    }
  },
  "overrides": {
    "onnxruntime-node": "1.29.0"
  },
  "scripts": {
    "dev": "bun --cwd apps/coding-agent src/index.ts",
    "dev:desktop": "bun run --filter='@nyx/desktop' dev",
    "desktop:make": "bun run --filter='@nyx/desktop' make",
    "typecheck": "bun run --filter='@nyx/*' typecheck",
    "lint": "bun run --filter='@nyx/*' lint",
    "test": "bun run --filter='@nyx/*' test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
