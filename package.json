{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nyx",
  "version": "0.1.0",
  "description": "A from-scratch desktop agent with hybrid cloud + local ONNX inference",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@types/fs-extra": "11.0.4",
      "@huggingface/transformers": "3.8.1",
      "hono": "4.13.5",
      "zod": "4.6.5",
      "ai": "7.0.99",
      "fs-extra": "11.4.0",
      "nanoid": "6.0.1"
    }
  },
  "overrides": {
    "onnxruntime-node": "1.29.0"
  },
  "scripts": {
    "dev": "bun run dev:desktop",
    "dev:desktop": "bun run --filter='@nyx/desktop' dev",
    "desktop:make": "bun run --filter='@nyx/desktop' make",
    "typecheck": "bun run --filter='@nyx/*' typecheck",
    "lint": "bun run --filter='@nyx/*' lint"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  }
}
