{
  "name": "@nyx/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./types": "./src/shared/types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && bun run scripts/build.ts",
    "dev": "bun run src/server.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@lancedb/lancedb": "catalog:",
    "@nyx/agent": "workspace:*",
    "@nyx/config": "workspace:*",
    "@nyx/knowledge": "workspace:*",
    "@nyx/llm": "workspace:*",
    "@nyx/shared": "workspace:*",
    "ai": "catalog:",
    "apache-arrow": "catalog:",
    "hono": "catalog:",
    "htmlparser2": "catalog:",
    "turndown": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/turndown": "catalog:"
  }
}
