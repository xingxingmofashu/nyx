{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nyx",
  "version": "0.1.0",
  "description": "A from-scratch desktop agent with hybrid cloud + local ONNX inference",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@types/bun": "1.4.0",
      "@types/node": "26.4.0",
      "typescript": "7.0.2",
      "@huggingface/transformers": "3.8.1",
      "onnxruntime-node": "1.29.0",
      "hono": "4.13.5",
      "@hono/node-server": "2.1.1",
      "yargs": "18.1.0",
      "zod": "3.25.76"
    }
  },
  "scripts": {
    "dev": "bun --cwd apps/coding-agent src/index.ts",
    "typecheck": "bun run --filter='@nyx/*' typecheck",
    "lint": "bun run --filter='@nyx/*' lint",
    "test": "bun run --filter='@nyx/*' test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
