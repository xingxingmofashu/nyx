{
  "name": "@nyx/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "build": "tsc --noEmit && bun run scripts/build.ts",
    "dev": "bun run src/bin.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@nyx/agent": "workspace:*",
    "@nyx/global": "workspace:*",
    "@nyx/llm": "workspace:*",
    "ai": "catalog:",
    "hono": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  }
}
